#!/bin/bash

readonly OPT_PATH="/opt"
readonly DOWNLOAD_PATH="$HOME/Downloads"
readonly APP_DESKTOP="$HOME/.local/share/applications"

usage() {
  cat <<EOF
Uso: $0 [-i archivo] [-u] [-h]

Opciones:
  -i  Instala la aplicación en /opt y crea el .desktop
  -u  Buscar actualizaciones
  -h  Ayuda
EOF
}

extract_app() {
  local archive="$1" file_type tmp name dest
  local -a entries

  file_type=$(file --mime-type -b "$archive")
  tmp=$(mktemp -d)

  case $file_type in
    application/zip)
      unzip -q "$archive" -d "$tmp" ;;
    application/gzip|application/x-xz|application/x-bzip2|application/x-tar)
      tar -xf "$archive" -C "$tmp" ;;
    *)
      echo "Tipo no soportado: $file_type" >&2
      rm -rf "$tmp"
      return 1 ;;
  esac

  mapfile -t entries < <(find "$tmp" -mindepth 1 -maxdepth 1)

  if [[ ${#entries[@]} -eq 1 && -d ${entries[0]} ]]; then
    name=$(basename "${entries[0]}")
    dest="$OPT_PATH/$name"
    sudo rm -rf "$dest"
    sudo mv "${entries[0]}" "$dest"
  else
    name=$(basename "$archive")
    name="${name%%.*}"   # postman-linux-x64
    name="${name%%-*}"   # postman
    name="${name^}"      # Postman
    dest="$OPT_PATH/$name"
    sudo rm -rf "$dest"
    sudo mkdir -p "$dest"
    sudo mv "$tmp"/* "$dest"/
  fi

  rm -rf "$tmp"
  echo "$dest"
}

find_executable() {
  local dir="$1" base c choice
  local -a candidates

  base=$(basename "$dir" | tr '[:upper:]' '[:lower:]')
  base="${base%%-*}"

  mapfile -t candidates < <(
    find "$dir" -maxdepth 3 -type f -executable \
      ! -name "*.so*" ! -name "*.sh" ! -name "chrome-sandbox" 2>/dev/null
  )

  [[ ${#candidates[@]} -eq 0 ]] && return 1

  for c in "${candidates[@]}"; do
    if [[ $(basename "$c" | tr '[:upper:]' '[:lower:]') == *"$base"* ]]; then
      echo "$c"
      return 0
    fi
  done

  if [[ ${#candidates[@]} -eq 1 ]]; then
    echo "${candidates[0]}"
    return 0
  fi

  echo "Varios ejecutables encontrados, elige uno:" >&2
  select choice in "${candidates[@]}"; do
    [[ -n $choice ]] && { echo "$choice"; return 0; }
  done
}

find_icon() {
  local dir="$1" base
  base=$(basename "$dir" | tr '[:upper:]' '[:lower:]')
  base="${base%%-*}"

  find "$dir" -type f \
    \( -iname "*icon*.png" -o -iname "*icon*.svg" \
       -o -iname "*logo*.png" -o -iname "*logo*.svg" \
       -o -iname "*${base}*.png" -o -iname "*${base}*.svg" \) \
    -print0 2>/dev/null \
    | xargs -0 -r ls -S 2>/dev/null \
    | head -n1
}

create_desktop_entry() {
  local app_dir="$1" name exec_path icon_path desktop_file

  name=$(basename "$app_dir")
  mkdir -p "$APP_DESKTOP"

  exec_path=$(find_executable "$app_dir") || {
    echo "No se encontró ejecutable en $app_dir" >&2
    return 1
  }
  icon_path=$(find_icon "$app_dir")

  desktop_file="$APP_DESKTOP/${name}.desktop"

  cat > "$desktop_file" <<EOF
[Desktop Entry]
Type=Application
Name=$name
Exec="$exec_path" %U
Icon=${icon_path:-application-x-executable}
Terminal=false
Categories=Utility;
EOF

  chmod +x "$desktop_file"
  update-desktop-database "$APP_DESKTOP" 2>/dev/null
  echo "Creado: $desktop_file"
}

install_app() {
  local archive="$1" app_dir

  [[ -f $archive ]] || archive="$DOWNLOAD_PATH/$archive"
  [[ -f $archive ]] || { echo "Archivo no encontrado: $1" >&2; return 1; }

  app_dir=$(extract_app "$archive") || return 1
  create_desktop_entry "$app_dir"
}

[[ $# -eq 0 ]] && { usage; exit 1; }

while getopts "i:uh" option; do
  case $option in
    i) install_app "$OPTARG" ;;
    u) echo "Buscando actualizaciones..." ;;
    h) usage; exit 0 ;;
    \?) usage; exit 1 ;;
  esac
done
